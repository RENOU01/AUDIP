# Copiá este archivo a ".env" (en la raíz del proyecto) y completá tus valores reales.
# El archivo ".env" NUNCA se sube a GitHub (está en .gitignore).

# Panel Supabase → Project Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# EmailJS (emailjs.com) → Account → API Keys / Email Services / Email Templates
VITE_EMAILJS_SERVICE_ID=tu-service-id
VITE_EMAILJS_TEMPLATE_ID=tu-template-id
VITE_EMAILJS_PUBLIC_KEY=tu-public-key
